# /etc/systemd/system/modemmenu.service - modemmenu -serve for app_dmodem's
# mode = unix profiles (dmodem.conf: path = /run/modemmenu/modemmenu.sock,
# header = yes); [server] socket_group = asterisk lets Asterisk connect
[Unit]
Description=modemmenu: login and menu for dial-up callers
Before=asterisk.service

[Service]
ExecStart=/usr/local/bin/modemmenu -config /etc/asterisk/modemmenu.conf -serve
RuntimeDirectory=modemmenu
RuntimeDirectoryMode=0755
# daily_limit's state_dir = /var/lib/modemmenu
StateDirectory=modemmenu
Restart=on-failure
# root for auth = system (PAM's pam_unix) and run_as; otherwise a user of
# its own, e.g. User=modemmenu
User=root

[Install]
WantedBy=multi-user.target
